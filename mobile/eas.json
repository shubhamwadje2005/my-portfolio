{
  "cli": {
    "version": ">= 21.0.2",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_LOCAL_URL": "http://192.168.1.21:5000",
        "EXPO_PUBLIC_LIVE_URL": "https://my-portfolio-server-three-iota.vercel.app",
        "EXPO_PUBLIC_NODE_ENV": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_LOCAL_URL": "http://192.168.1.21:5000",
        "EXPO_PUBLIC_LIVE_URL": "https://my-portfolio-server-three-iota.vercel.app",
        "EXPO_PUBLIC_NODE_ENV": "production"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_LOCAL_URL": "http://192.168.1.21:5000",
        "EXPO_PUBLIC_LIVE_URL": "https://my-portfolio-server-three-iota.vercel.app",
        "EXPO_PUBLIC_NODE_ENV": "production"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
